+  const pending = new Promise<void>(yes => { resolve = yes; });
+  vi.mocked(apiFetch).mockResolvedValue({ok:true, blob: async () => new Blob(["audio"])} as Response);
+  render(<PlayAudioButton content="Hello" autoPlayFresh={false} />);
+  await act(async () => {
