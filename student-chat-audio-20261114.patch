--- /dev/null
+++ b/tests/services/test_chat_speech.py
@@ -0,0 +1,117 @@
+"""Speech artifacts preserve full text, provider settings and workspace ownership."""
+from pathlib import Path
+from unittest.mock import AsyncMock
+import pytest
+from deeptutor.services.voice.config import TTSConfig
+from deeptutor.services.voice.base import VoiceProviderError
+from deeptutor.tools.media_gen_tool import SpeechgenTool
+
+@pytest.fixture
+def speech(monkeypatch):
+    config = TTSConfig(model="edge-tts", adapter="edge", voice="zh-CN-XiaoxiaoNeural")
+    synth = AsyncMock(return_value=(b"ID3-test-speech", "audio/mpeg"))
+    monkeypatch.setattr("deeptutor.services.config.provider_runtime.resolve_tts_runtime_config", lambda: config)
+    monkeypatch.setattr("deeptutor.services.voice.base.synthesize_with_timeout", synth)
+    return config, synth
+
+@pytest.mark.asyncio
+async def test_speech_is_presented_and_persisted_as_audio(monkeypatch, tmp_path, speech):
+    from deeptutor.services.workspace import get_content_workspace_service
+    from deeptutor.services.session.artifact_attachments import artifact_attachments
+    from deeptutor.core.stream import StreamEvent, StreamEventType
+    monkeypatch.setenv("DEEPTUTOR_WORKSPACE_ROOT", str(tmp_path))
+    service = get_content_workspace_service()
+    runtime = service.create_runtime_context(capability="chat", session_id="speech-chat", turn_id="speech-turn")
+    result = await SpeechgenTool().execute(text="Ben went to the park. He wasn't tired.", language="en-US", speed=0.8, title="Listening practice", _workspace_id=runtime.workspace_id, _workspace_dir=str(Path(runtime.output_dir)/"media"))
+    assert result.success, result.content
+    config, synth = speech
+    assert synth.await_args.args[1] == "Ben went to the park. He wasn't tired."
+    assert config.voice == "en-US-AriaNeural" and config.speed == 0.8
+    item, = result.metadata["workspace_items"]
+    assert item["mime_type"] == "audio/mpeg" and item["url"].startswith("/files/workspace-items/")
+    snapshot, published = service.resolve_published_item(runtime.workspace_id, item["workspace_item_id"])
+    assert snapshot.read_bytes() == b"ID3-test-speech"
+    assert published.title == "Listening practice"
+    assert str(tmp_path) not in result.content
+    event = StreamEvent(type=StreamEventType.SOURCES, metadata={"sources": result.sources})
+    attachment, = artifact_attachments(event)
+    assert attachment["mime_type"] == "audio/mpeg" and attachment["generated"] is True
+    assert attachment["workspace_item_id"] == item["workspace_item_id"]
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("kwargs", [{"text":""}, {"text":"hello","speed":True}, {"text":"hello","speed":float("nan")}, {"text":"hello","speed":0.1}, {"text":"hello","language":"invalid"}])
+async def test_invalid_script_does_not_call_provider(speech, kwargs):
+    result = await SpeechgenTool().execute(**kwargs)
+    assert not result.success
+    speech[1].assert_not_awaited()
+
+@pytest.mark.asyncio
+async def test_long_script_is_not_silently_cut(speech):
+    speech[0].max_input_chars = 8
+    result = await SpeechgenTool().execute(text="Complete script")
+    assert not result.success and "no text was truncated" in result.content
+    speech[1].assert_not_awaited()
+
+@pytest.mark.asyncio
+async def test_failure_does_not_disclose_provider_secrets_or_fake_audio(speech):
+    speech[1].side_effect = VoiceProviderError("secret-token and internal provider body")
+    result = await SpeechgenTool().execute(text="Hello")
+    assert not result.success and not result.sources and not result.metadata
+    assert "secret-token" not in result.content
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("payload", [(b"", "audio/mpeg"), (b"<html>not audio</html>","text/html")])
+async def test_empty_or_non_audio_is_not_presented(speech, payload):
+    speech[1].return_value = payload
+    result = await SpeechgenTool().execute(text="Hello")
+    assert not result.success and not result.sources
+
+@pytest.mark.asyncio
+async def test_configured_paid_provider_voice_is_kept(monkeypatch, tmp_path, speech):
+    monkeypatch.setenv("DEEPTUTOR_WORKSPACE_ROOT", str(tmp_path))
+    config, synth = speech
+    config.adapter, config.voice = "openai_compat", "saved-voice"
+    result = await SpeechgenTool().execute(text="Hello", language="en-GB")
+    assert result.success and synth.await_args.args[2].voice == "saved-voice"
+
+
+def test_speech_registry_and_partner_deny_remain_enforced():
+    from deeptutor.tools.builtin_specs import BUILTIN_TOOL_SPEC_BY_NAME
+    from deeptutor.agents._shared.tool_composition import ToolMountFlags, compose_enabled_tools
+    class Registry:
+        def get_enabled(self, _requested): return []
+    kwargs = dict(registry=Registry(), requested_tools=[], optional_whitelist=[], mount_flags=ToolMountFlags())
+    assert isinstance(BUILTIN_TOOL_SPEC_BY_NAME["speechgen"].create(), SpeechgenTool)
+    assert "speechgen" in compose_enabled_tools(**kwargs)
+    assert "speechgen" not in compose_enabled_tools(**kwargs, builtin_whitelist=set())
+
+
+@pytest.mark.asyncio
+async def test_pcm_audio_is_wrapped_without_an_external_encoder(monkeypatch, tmp_path, speech):
+    import io, wave
+    monkeypatch.setenv("DEEPTUTOR_WORKSPACE_ROOT", str(tmp_path))
+    speech[1].return_value = (b"\x01\x00" * 240, "audio/pcm;rate=24000;channels=1")
+    result = await SpeechgenTool().execute(text="Hello")
+    assert result.success
+    item, = result.metadata["workspace_items"]
+    from deeptutor.services.workspace import get_content_workspace_service
+    snapshot, _ = get_content_workspace_service().resolve_published_item(item["workspace_id"], item["workspace_item_id"])
+    with wave.open(io.BytesIO(snapshot.read_bytes()), "rb") as wav:
+        assert wav.getframerate() == 24000 and wav.getnchannels() == 1 and wav.getnframes() == 240
+    assert item["mime_type"] == "audio/x-wav" or item["mime_type"] == "audio/wav"
+
+
+def test_speech_hints_direct_the_model_to_a_real_file():
+    for language in ("zh", "en"):
+        hints = SpeechgenTool().get_prompt_hints(language)
+        assert hints.phase == "synthesis"
+        assert "HTML" in hints.guideline and "ffmpeg" in hints.guideline
+
+
+def test_no_configured_tts_means_no_speech_tool(monkeypatch):
+    from deeptutor.agents._shared.tool_runtime import drop_unconfigured_generation_tools
+    from deeptutor.services.config.model_catalog import get_model_catalog_service
+    service = get_model_catalog_service()
+    monkeypatch.setattr(service, "load", lambda: {})
+    monkeypatch.setattr(service, "get_active_model", lambda *args: None)
+    assert drop_unconfigured_generation_tools(["speechgen", "workspace_present"]) == ["workspace_present"]
