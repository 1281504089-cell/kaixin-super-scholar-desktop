+class SpeechgenTool(BaseTool):
+    """Generate and present a durable, directly playable speech attachment."""
+
+    def get_prompt_hints(self, language: str = "en"):
+        return load_prompt_hints(self.name, language=language)
+
+    def get_definition(self) -> ToolDefinition:
+        return ToolDefinition(
+            name="speechgen",
+            description=(
+                "Generate a real audio file from the exact text to be spoken, using the "
+                "configured text-to-speech service. Presents a playable audio card in chat "
+                "automatically. For listening exercises, read-aloud and audio-file requests "
+                "use this tool, not exec, say, ffmpeg or HTML. Only claim success after it succeeds."
+            ),
+            parameters=[
+                ToolParameter(name="text", type="string", description="Complete spoken script, without HTML, Markdown, stage directions or synthesis commands."),
+                ToolParameter(name="language", type="string", description="Language/accent of the spoken text, not the conversation UI.", required=False, enum=["en-US", "en-GB", "zh-CN"]),
+                ToolParameter(name="speed", type="number", description="Optional speaking speed; 0.8 for slower practice, 1 for normal. Omit to keep the configured speed.", required=False, minimum=0.5, maximum=2),
+                ToolParameter(name="title", type="string", description="Short title for the audio card.", required=False),
+            ],
+        )
+
+    async def execute(self, **kwargs: Any) -> ToolResult:
+        from deeptutor.services.config.provider_runtime import resolve_tts_runtime_config
+        from deeptutor.services.voice.audio import _parse_pcm_content_type, _pcm16_to_wav
+        from deeptutor.services.voice.base import VoiceProviderError, synthesize_with_timeout
+        from deeptutor.services.voice import get_tts_adapter
+        from deeptutor.tools.workspace import WorkspacePresentTool
+
+        text = kwargs.get("text")
+        if not isinstance(text, str) or not text.strip():
+            return ToolResult(content="speechgen requires a non-empty spoken text.", success=False)
+        text = text.strip()
+        language = kwargs.get("language") or ("zh-CN" if re.search(r"[\u4e00-\u9fff]", text) else "en-US")
+        if language not in {"en-US", "en-GB", "zh-CN"}:
+            return ToolResult(content="Choose speech language en-US, en-GB or zh-CN.", success=False)
+        speed = kwargs.get("speed")
+        if speed is not None and (isinstance(speed, bool) or not isinstance(speed, (int, float)) or not math.isfinite(speed) or not 0.5 <= speed <= 2):
+            return ToolResult(content="Speech speed must be a number between 0.5 and 2.", success=False)
+        try:
+            config = resolve_tts_runtime_config()
+            if len(text) > config.max_input_chars:
+                return ToolResult(content=f"The spoken script exceeds this voice service's {config.max_input_chars}-character limit. Split it into complete shorter audio clips; no text was truncated or generated.", success=False)
+            config.language = language
+            if speed is not None:
+                config.speed = speed
+            if config.adapter == "edge":
+                # Match the exercise language without changing the user's saved voice.
+                if not (config.voice or "").startswith(language + "-"):
+                    config.voice = {"en-US": "en-US-AriaNeural", "en-GB": "en-GB-SoniaNeural", "zh-CN": "zh-CN-XiaoxiaoNeural"}[language]
+                config.response_format = "mp3"
+            audio, content_type = await synthesize_with_timeout(get_tts_adapter(config.adapter), text, config)
+        except ValueError:
+            return ToolResult(content="语音服务尚未正确配置，请在设置的语音服务中选择可用的声音后重试。", success=False)
+        except VoiceProviderError as exc:
+            logger.warning("speechgen failed: %s", type(exc).__name__)
+            return ToolResult(content=exc.public_message or "音频生成未完成，请检查网络和语音服务设置后重试。不要把文字、HTML 或空文件当作音频。", success=False)
+        pcm_info = _parse_pcm_content_type(content_type)
+        if pcm_info:
+            audio = _pcm16_to_wav(audio, sample_rate=pcm_info[0], channels=pcm_info[1])
+            content_type = "audio/wav"
+        mime = (content_type or "").split(";")[0].strip().lower()
+        if not audio or len(audio) > 25 * 1024 * 1024 or not mime.startswith("audio/") or mime not in _EXT_BY_CONTENT_TYPE:
+            return ToolResult(content="语音服务没有返回可播放的音频文件，请重试或更换语音服务。", success=False)
+        workspace_id = str(kwargs.get("_workspace_id") or "")
+        run_dir, workspace_id = _run_dir(kwargs.get("_workspace_dir"), "speechgen", workspace_id=workspace_id)
+        artifacts = _write_media(run_dir, [(audio, mime)], stem="speech", default_ext="mp3", workspace_id=workspace_id)
+        title = str(kwargs.get("title") or "音频").strip()[:120]
+        result = await WorkspacePresentTool().execute(
+            items=[{"path": item.relative_path, "title": title} for item in artifacts],
+            _workspace_id=workspace_id,
+        )
+        if result.success:
+            result.content = "Audio generated and presented as a playable card in chat. " + result.content
+        return result
+
+
 class ImagegenTool(BaseTool):
     """Generate images from a text prompt via the configured imagegen model."""
 
