diff --git a/web/tests/science-formulas.spec.tsx b/web/tests/science-formulas.spec.tsx
new file mode 100644
index 0000000..db04e51
--- /dev/null
+++ b/web/tests/science-formulas.spec.tsx
@@ -0,0 +1,93 @@
+import { render, waitFor, cleanup } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+import MarkdownRenderer from '@/components/common/MarkdownRenderer'
+import InlineMarkdown from '@/components/common/InlineMarkdown'
+import NoteMath from '@/features/notes/components/NoteMath'
+import { hasMarkdownMath, convertLatexDelimiters } from '@/lib/latex'
+import { initI18n } from '@/i18n/init'
+initI18n('zh')
+afterEach(cleanup)
+
+const cases = [
+  ['physics-vector', String.raw`\vec{F}=m\vec{a}`],
+  ['physics-units', String.raw`v=9.8\,\mathrm{m}\,\mathrm{s}^{-1}`],
+  ['physics-derivative', String.raw`a=\frac{\mathrm{d}v}{\mathrm{d}t},\quad v=\frac{\partial x}{\partial t}`],
+  ['physics-electricity', String.raw`R=10\,\mathrm{k}\Omega,\quad I=2\,\mu\mathrm{A}`],
+  ['chemistry-charge', String.raw`\ce{Fe^{3+} + 3 OH- -> Fe(OH)3 v}`],
+  ['chemistry-reversible', String.raw`\ce{N2 + 3H2 <=> 2NH3}`],
+  ['chemistry-conditions', String.raw`\ce{CaCO3 ->[\Delta] CaO + CO2 ^}`],
+  ['chemistry-isotope', String.raw`\ce{^{14}_{6}C}`],
+  ['chemistry-chinese-conditions', String.raw`\ce{2H2 + O2 ->[\text{点燃}] 2H2O}`],
+  ['biology-photosynthesis', String.raw`\ce{6CO2 + 6H2O ->[\text{光照}] C6H12O6 + 6O2}`],
+  ['geography-ratio', String.raw`\text{比例尺}=\frac{\text{图上距离}}{\text{实际距离}}`],
+  ['science-physical-units', String.raw`\pu{1.2e3 J mol-1}`],
+] as const
+for (const [name, formula] of cases) {
+  describe(name, () => {
+    it('renders in chat Markdown without raw unsupported commands', async () => {
+      const { container } = render(<MarkdownRenderer content={`本题：$${formula}$。`} allowHtml={false} />)
+      await waitFor(() => expect(container.querySelector('.katex-html')).not.toBeNull())
+      expect(container.querySelector('.katex-error')).toBeNull()
+      expect(container.querySelector('.katex-html')?.textContent).not.toMatch(/\\(?:ce|pu|vec|frac)/)
+      expect(container.querySelector('annotation')?.textContent).toBe(formula)
+    })
+    it('renders in inline questions and saved note formulas', async () => {
+      const { container, rerender } = render(<InlineMarkdown content={`$${formula}$`} />)
+      await waitFor(() => expect(container.querySelector('.katex-html')).not.toBeNull())
+      expect(container.querySelector('.katex-error')).toBeNull()
+      expect(container.querySelector('.katex-html')?.textContent).not.toMatch(/\\(?:ce|pu|vec|frac)/)
+      rerender(<NoteMath formula={formula} />)
+      expect(container.querySelector('.katex-html')).not.toBeNull()
+      expect(container.querySelector('.katex-error')).toBeNull()
+      expect(container.querySelector('annotation')?.textContent).toBe(formula)
+      expect(container.querySelector('.katex-html')?.textContent).not.toMatch(/\\(?:ce|pu|vec|frac)/)
+    })
+  })
+}
+it.each([String.raw`\ce{2H2 + O2 -> 2H2O}`, String.raw`\pu{9.8 m/s2}`])('recognizes explicit chemistry/unit commands without dollar delimiters: %s', formula => {
+  expect(hasMarkdownMath(formula)).toBe(true)
+  expect(convertLatexDelimiters(`读作 ${formula}。`)).toBe(`读作 $${formula}$。`)
+})
+it('does not turn incomplete commands, paths or fenced source examples into formulas', () => {
+  for (const value of [String.raw`C:\ce\notes`, String.raw`C:\pu\units`, String.raw`\ce`, String.raw`\pu`]) {
+    expect(convertLatexDelimiters(value)).toBe(value)
+    expect(hasMarkdownMath(value)).toBe(false)
+  }
+  const code = '```tex\n\\ce{H2O}\n\\pu{9.8 m/s2}\n```'
+  expect(convertLatexDelimiters(code)).toBe(code)
+})
+
+it('keeps chemistry charge, reaction direction and unit source intact through note table import', async () => {
+  const { BlockNoteEditor } = await import('@blocknote/core')
+  const { parseNoteMarkdown, normalizeNoteMath } = await import('@/features/notes/model/markdown')
+  const { blockPreview } = await import('@/features/notes/model/blocks')
+  const editor = BlockNoteEditor.create()
+  const charge = String.raw`\ce{Fe^{3+} + 3OH- -> Fe(OH)3 v}`
+  const equilibrium = String.raw`\ce{N2 + 3H2 <=> 2NH3}`
+  const units = String.raw`\pu{9.8 m/s2}`
+  const original = `| 原件 | 公式 |\n|---|---|\n| 电荷 | $${charge}$ |\n| 可逆反应 | $${equilibrium}$ |\n| 单位 | ${units} |`
+  try {
+    const blocks = parseNoteMarkdown(original, text => editor.tryParseMarkdownToBlocks(text) as import('@/lib/notes-api').NoteBlock[])
+    const before = structuredClone(blocks)
+    const normalized = normalizeNoteMath(blocks)
+    expect(blocks).toEqual(before)
+    const roundtrip = normalized.map(blockPreview).join('\n')
+    expect(roundtrip).toContain(charge)
+    expect(roundtrip).toContain(equilibrium)
+    expect(roundtrip).toContain(units)
+    expect(JSON.stringify(normalized).match(/inlineMath/g)).toHaveLength(3)
+  } finally { editor._tiptapEditor.destroy() }
+})
+it('retains trust restrictions after loading the chemistry extension', () => {
+  const { container } = render(<NoteMath formula={String.raw`\href{javascript:alert(1)}{unsafe}`} />)
+  expect(container.querySelector('a, img, iframe')).toBeNull()
+})
+it('typesets reversible and forward arrows, charge superscripts and precipitate markers', () => {
+  const { container, rerender } = render(<NoteMath formula={String.raw`\ce{N2 + 3H2 <=> 2NH3}`} />)
+  expect([...container.querySelectorAll('math mo')].map(node=>node.textContent)).toContain('⇌')
+  rerender(<NoteMath formula={String.raw`\ce{Fe^{3+} + 3OH- -> Fe(OH)3 v}`} />)
+  const operators=[...container.querySelectorAll('math mo')].map(node=>node.textContent)
+  expect(operators).toContain('→')
+  expect(operators).toContain('↓')
+  expect([...container.querySelectorAll('math msup')].some(node=>node.textContent?.includes('3+'))).toBe(true)
+})
