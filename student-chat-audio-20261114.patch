@@ -0,0 +1,24 @@
+"use client";
+
+import { useRef, useState } from "react";
+import { useTranslation } from "react-i18next";
+
+/** Play a saved audio file without synthesis, scripts or a document preview. */
+export default function AudioPlayer({ url, filename }: { url: string; filename: string }) {
+  const { t } = useTranslation();
+  const player = useRef<HTMLAudioElement>(null);
+  const [failed, setFailed] = useState(false);
+  return (
+    <div className="w-full min-w-0 space-y-2">
+      <audio ref={player} src={url} controls preload="metadata" aria-label={filename}
